author = Andrzej Cichocki
author_email = 3613868+combatopera@users.noreply.github.com
buildbot enabled = true
github account = combatopera
internal_module +=
    lurlene.bridge
    lurlene.context
    lurlene.model
    lurlene.osc
    lurlene.parse
    lurlene.transform
    lurlene.util
    lurlene.xtra
name = Lurlene
pypi account = combatopera
pyversions += 3
requires +=
    diapyr>=18
    numpy>=$(numpy_build_version)
    splut>=4
    timelyOSC>=4
tagline = Python-based live-coding language optimised for a small number of channels
years += 2019
